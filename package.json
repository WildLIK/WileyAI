{
  "name": "wileyai",
  "version": "0.10.3",
  "private": true,
  "description": "Р›РѕРєР°Р»СЊРЅС‹Р№ РїРµСЂСЃРѕРЅР°Р»СЊРЅС‹Р№ Р°СЃСЃРёСЃС‚РµРЅС‚ РґР»СЏ Windows",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "setup:python": "uv sync --extra dev",
    "setup:qwen": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-qwen.ps1",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node scripts/python.mjs -m pytest",
    "test:voice": "node --experimental-strip-types --test tests/voice/*.test.ts tests/voice/*.test.cjs",
    "test:avatar": "node scripts/test-avatar.mjs",
    "test:desktop": "playwright test",
    "check": "npm run build && npm test && npm run test:voice",
    "format": "prettier --write src desktop scripts/*.mjs tests/desktop/*.ts",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "package:win": "npm run build && npm run prepare:runtime && electron-builder --win --publish never",
    "package:dir": "npm run build && npm run prepare:runtime && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  },
  "author": "WildLIK"
}

{
  "name": "wileyai",
  "version": "0.1.0",
  "private": true,
  "description": "Локальный персональный ассистент для Windows",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "setup:python": "uv sync --extra dev",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node scripts/python.mjs -m pytest",
    "test:desktop": "playwright test",
    "check": "npm run build && npm test",
    "format": "prettier --write src desktop scripts/*.mjs tests/desktop/*.ts"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "electron": "44.7.2",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
